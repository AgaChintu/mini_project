# ==============================================================================
# ClariQ Supabase PostgreSQL Environment Template
# Copy this file to .env and configure it with your credentials.
# Never commit .env with real secrets to Git!
# ==============================================================================

APP_ENV=development

# Supabase Project Configuration
SUPABASE_URL=https://xkxpptzhirajzjntkrlb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_VQNuPCj6EPq6BcaGMu3fvg_jIj-9RvJ
SUPABASE_SECRET_KEY=your_rotated_secret_key_here
SUPABASE_JWKS_URL=https://xkxpptzhirajzjntkrlb.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=clariq-attachments

# Supabase PostgreSQL Connection String
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Format: postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.xkxpptzhirajzjntkrlb.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@db.xkxpptzhirajzjntkrlb.supabase.co:5432/postgres
SQL_ECHO=false

# ClariQ JWT Authentication (preserves existing custom auth)
JWT_SECRET_KEY=clariq-development-secret-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:8000,http://localhost:8000

# Legacy Local Upload Directory Fallback
UPLOAD_DIR=

# Groq AI Chatbot Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

